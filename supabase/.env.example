# Copia este archivo a supabase/.env y completa los valores. supabase/.env NO se sube a Git.
# Estos valores son SECRETOS de servidor: nunca van en app/ ni en variables VITE_*.

# Correo transaccional (Brevo): Settings > SMTP & API > SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente verificado en Brevo (Settings > Senders, Domains, IPs > Senders)
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MyGuide

# Turnstile (Cloudflare): clave SECRETA del widget
TURNSTILE_SECRET_KEY=

# Carga del catálogo de alimentos en producción (npm run import:off:prod / import:usda:prod).
# Proyecto de Supabase de producción: Project Settings > API (URL y clave service_role).
# La clave service_role es un SECRETO: da acceso total a la base. Nunca va en app/ ni en Git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: identifica tu aplicación ante Open Food Facts (incluye un contacto).
OFF_USER_AGENT=
