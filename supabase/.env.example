# Copia este archivo a supabase/.env y completa los valores. supabase/.env NO se sube a Git.
# Estos valores son SECRETOS de servidor: nunca van en app/ ni en variables VITE_*.

# Correo transaccional (Brevo): Settings > SMTP & API > SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente verificado en Brevo (Settings > Senders, Domains, IPs > Senders)
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MyGuide

# Turnstile (Cloudflare): clave SECRETA del widget
TURNSTILE_SECRET_KEY=
