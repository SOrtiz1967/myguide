# Entorno LOCAL de las Edge Functions. Copiar a supabase/.env.local (que no se sube a Git).
# Envia el correo al buzon de pruebas de Supabase (Mailpit), nunca a un proveedor real.
SMTP_HOST=inbucket
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@myguide.local
SMTP_FROM_NAME=MyGuide
# Clave de PRUEBA de Cloudflare: el captcha siempre aprueba.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
ALLOWED_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173
FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
