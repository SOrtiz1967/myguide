{
  "nodeModulesDir": "none",
  "imports": {
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@2",
    "@std/assert": "jsr:@std/assert@1",
    "nodemailer": "npm:nodemailer@6",
    "@std/toml": "jsr:@std/toml@1"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 100
  },
  "tasks": {
    "test": "deno test --allow-env=ALLOWED_ORIGINS",
    "check": "deno check */*.ts _shared/*.ts"
  }
}
